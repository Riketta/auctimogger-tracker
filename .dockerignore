# Build context hygiene: nothing here is needed inside the image.
.git
.github
target
dist
data
feeds
logs
*.log
Dockerfile
docker-compose.yml
config.docker.toml
# Secrets and docs never belong in a build context (versa-bot precedent).
.env*
README.md
AGENTS.md
# The image needs only the deployable addon folder (it is embedded with
# include_str!): not the specs, the scripts, or the gitignored Lua tool tree.
addon/*
!addon/AuctiMoggerDatabase
