# Generated byte-for-byte by crates/infra/tests/database_golden.rs, which
# compares what it renders with the committed file. Keep these LF in every
# working tree: with core.autocrlf=true (the default on Windows, and what the
# windows CI runner checks out with) they would turn CRLF and fail that check.
fixtures/database_v4.lua text eol=lf
fixtures/database_v4.json text eol=lf
fixtures/database_v4_decoded.lua text eol=lf

# The addon tree is read by the Lua toolchain: StyLua checks Unix line
# endings, and luacheck / busted run in WSL and on CI. Keep it LF in every
# working tree.
addon/** text eol=lf
